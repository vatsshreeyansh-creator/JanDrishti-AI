# ==============================================================================
# JanDrishti AI - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# In Vercel, configure these variables under Project Settings -> Environment Variables.
# ==============================================================================

# Backend API Base URL (leave unset for local dev to use default: http://localhost:8000/api)
# Production example: https://jandrishti-ai-backend.onrender.com/api
VITE_API_URL=

# ==============================================================================
# Map Provider Configuration
# Supported providers: mapmyindia | carto | osm | mapbox | custom
# Default: mapmyindia
# ==============================================================================
VITE_MAP_PROVIDER=mapmyindia

# MapmyIndia (Mappls) Web Maps Static Key / Access Token
# Obtain this key from the Mappls Developer Console: https://auth.mappls.com/console
# IMPORTANT:
# - In Mappls Console, ensure your domain (e.g. http://localhost:5173 for local dev,
#   or your production domain on Vercel) is added to the Domain Whitelist for this key,
#   or whitelist your IP address. Otherwise, Mappls will reject access with HTTP 401
#   "IP/Domain validation failed".
# - JanDrishti strictly surfaces genuine provider errors rather than silently switching providers.
VITE_MAPMYINDIA_KEY=

# Generic token for other providers (e.g. Mapbox access token if VITE_MAP_PROVIDER=mapbox)
# VITE_MAP_API_KEY=

# Optional: Custom tile server URL template (if VITE_MAP_PROVIDER=custom)
# VITE_MAP_CUSTOM_TILE_URL=
