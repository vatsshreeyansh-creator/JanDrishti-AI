# ==============================================================================
# JanDrishti AI - Environment Configuration Example
# Copy this file to .env or .env.local for local overrides.
# In Vercel, configure these variables under Project Settings -> Environment Variables.
# ==============================================================================

# Backend API Base URL (leave unset for local dev to use default: http://localhost:8000/api)
# Production example: https://jandrishti-ai-backend.onrender.com/api
VITE_API_URL=

# ==============================================================================
# Map Provider Configuration
# Supported providers: mapmyindia | carto | osm | mapbox | custom
# Default: mapmyindia
# ==============================================================================
VITE_MAP_PROVIDER=mapmyindia

# MapmyIndia (Mappls) REST / API Key
# Sign up and generate your API key at: https://apis.mappls.com/console/
# If left empty, JanDrishti automatically falls back to Carto/OSM tiles so maps continue working.
VITE_MAPMYINDIA_KEY=

# Generic fallback for other providers (e.g. Mapbox access token if VITE_MAP_PROVIDER=mapbox)
# VITE_MAP_API_KEY=

# Optional: Custom tile server URL template
# VITE_MAP_CUSTOM_TILE_URL=
